# Development environment template.
# Copy to .env and fill in the values.

NODE_ENV=development
PORT=3000

# Where the frontend is served from (CORS for Express and Socket.IO).
CLIENT_ORIGIN=http://localhost:8080

# MongoDB. Local docker-compose or any MongoDB connection string.
MONGO_URI=mongodb://localhost:27017/loop

# Long random string used to sign auth tokens. Generate with: openssl rand -hex 32
JWT_SECRET=replace-with-a-long-random-secret

# Cloudinary — used for chat image uploads. Leave empty to disable uploads.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_UPLOAD_PRESET=loop_chat
