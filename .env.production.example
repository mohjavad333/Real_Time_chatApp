# Production environment template — used by the server container/host.
# Copy to .env (or paste into your host's env settings) and fill in real values.
# NEVER commit the filled-in file.

NODE_ENV=production
PORT=3000

# Public URL of the deployed frontend (no trailing slash).
# CORS for BOTH Express and Socket.IO is restricted to this origin.
CLIENT_ORIGIN=https://your-domain.example

# MongoDB connection string.
# Option A (self-hosted with docker-compose): mongodb://mongodb:27017/loop
# Option B (MongoDB Atlas): mongodb+srv://<user>:<password>@<cluster>/loop?retryWrites=true&w=majority
MONGO_URI=

# Long random secret for signing auth tokens (96 hex chars is fine).
# Generate with: openssl rand -hex 48
# Rotate = all existing sessions get logged out. Keep it secret; never commit it.
JWT_SECRET=

# Cloudinary — required only for chat image uploads. Leave empty to disable.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_UPLOAD_PRESET=loop_chat
